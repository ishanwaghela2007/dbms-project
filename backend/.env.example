PORT=4000
NODE_ENV=development
JWT_SECRET=CHANGE_ME_minimum_32_chars_random_secret_here
JWT_ISSUER=college-erp
JWT_AUDIENCE=college-erp-api
JWT_ACCESS_TTL=15m

# Internal service-to-service signing secret (different from JWT_SECRET)
SERVICE_AUTH_SECRET=CHANGE_ME_minimum_32_chars_service_secret_here
SERVICE_AUTH_TTL=30s

# Database connection string (TiDB Cloud / Managed MySQL / Local)
# TiDB Cloud example: mysql://<prefix>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/college_erp
# Local MySQL example: mysql://erp_user:CHANGE_ME@127.0.0.1:3306/college_erp
DATABASE_URL=mysql://erp_user:CHANGE_ME@127.0.0.1:3306/college_erp


REDIS_URL=redis://127.0.0.1:6379
AUTHZ_CACHE_TTL_SECONDS=30

FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_NAME=CampusFlow Administrator

AUTH_GRPC_ADDR=127.0.0.1:50051
PROFILE_GRPC_ADDR=127.0.0.1:50052
ACADEMIC_GRPC_ADDR=127.0.0.1:50053
MARKS_GRPC_ADDR=127.0.0.1:50054
ATTENDANCE_GRPC_ADDR=127.0.0.1:50055
PAPER_GRPC_ADDR=127.0.0.1:50056
NOTIFICATION_GRPC_ADDR=127.0.0.1:50057

PDF_OCR_ENABLED=true
PDF_MAX_PAGES=40
MARKS_PDF_MAX_MB=8
LOW_ATTENDANCE_THRESHOLD=75

# Cloudinary — create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_PAPERS_FOLDER=college-erp/papers
CLOUDINARY_MARKS_FOLDER=college-erp/marks-validation
CLOUDINARY_PROFILES_FOLDER=college-erp/profiles

# SMTP — use a Gmail App Password (not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASS=CHANGE_ME_app_password
SMTP_FROM="CampusFlow ERP" <CHANGE_ME@gmail.com>
